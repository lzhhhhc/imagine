/** 长任务使用有阶段感的稳定状态，不让用户盯着一个小转圈。 */
@Composable
fun GenerationStatus(
    elapsedSeconds: Int,
    mode: String,
    completed: Int = 0,
    total: Int = 1,
    modifier: Modifier = Modifier
) {
    val backdrop = com.lo.imagine.ui.theme.LocalFlavor.current.backdrop
    if (backdrop == com.lo.imagine.ui.theme.BackdropKind.ARK_TERMINAL) {
        ArkGenerationStatus(
            elapsedSeconds = elapsedSeconds,
            mode = mode,
            completed = completed,
            total = total,
            modifier = modifier
        )
        return
    }
    if (backdrop == com.lo.imagine.ui.theme.BackdropKind.SKY) {
        SkyGenerationStatus(
            elapsedSeconds = elapsedSeconds,
            mode = mode,
            completed = completed,
            total = total,
            modifier = modifier
        )
        return
    }
    val accents = LocalPopAccents.current
    val stageLabel = if (total > 1) {
        if (completed == 0) "生成中 · 排队请求" else "生成中 · 已完成 $completed / $total"
    } else {
        "生成中 · 等待模型返回"
    }
    val progressFraction = if (total <= 0) 0f else (completed.toFloat() / total).coerceIn(0f, 1f)
    Surface(
        color = MaterialTheme.colorScheme.surface,
        contentColor = MaterialTheme.colorScheme.onSurface,
        shape = RoundedCornerShape(20.dp),
        border = androidx.compose.foundation.BorderStroke(1.5.dp, celInk()),
        modifier = modifier
            .fillMaxWidth()
            .celShadow(RoundedCornerShape(20.dp), dx = 2.dp, dy = 2.dp)
    ) {
        Column(Modifier.padding(18.dp)) {
            Row(verticalAlignment = Alignment.CenterVertically) {
                Text(
                    stageLabel,
                    style = MaterialTheme.typography.titleSmall,
                    fontWeight = FontWeight.SemiBold
                )
                Spacer(Modifier.weight(1f))
                Text(
                    "${elapsedSeconds}s",
                    style = MaterialTheme.typography.labelLarge,
                    color = MaterialTheme.colorScheme.onSurfaceVariant,
                    fontWeight = FontWeight.Black
                )
            }
            Spacer(Modifier.height(10.dp))
            // AI 渲染马赛克——暗示"模型正在生成画面"
            RunnerDinoLoader(trackHeight = 56.dp)
            Spacer(Modifier.height(10.dp))
            // 真实进度条：按已完成张数/总张数填充（不是按时间假装）
            Box(
                Modifier
                    .fillMaxWidth()
                    .height(6.dp)
                    .clip(RoundedCornerShape(50))
                    .background(MaterialTheme.colorScheme.onPrimaryContainer.copy(alpha = .14f))
            ) {
                Box(
                    Modifier
                        .fillMaxHeight()
                        .fillMaxWidth(progressFraction)
                        .background(accents.a)
                )
            }
            if (total > 1) {
                Spacer(Modifier.height(12.dp))
                Text(
                    if (completed == 0) "正在并行生成 $total 张" else "已完成 $completed / $total 张",
                    style = MaterialTheme.typography.bodySmall,
                    color = MaterialTheme.colorScheme.onSurfaceVariant
                )
            }
        }
    }
}

/** SKY 生成状态：糖果色轨道、星芒节点和真实批次进度。 */
@Composable
private fun SkyGenerationStatus(
    elapsedSeconds: Int,
    mode: String,
    completed: Int,
    total: Int,
    modifier: Modifier = Modifier
) {
    val scheme = MaterialTheme.colorScheme
    val progress = if (total <= 0) 0f else (completed.toFloat() / total).coerceIn(0f, 1f)
    val title = when (mode.lowercase()) {
        "edit", "retouch" -> "SKY // RETOUCHING"
        else -> "SKY // CREATING"
    }
    val transition = rememberInfiniteTransition(label = "skyGenerationMotion")
    val pulse by transition.animateFloat(
        initialValue = .42f,
        targetValue = 1f,
        animationSpec = infiniteRepeatable(tween(820, easing = FastOutSlowInEasing), RepeatMode.Reverse),
        label = "skyGenerationPulse"
    )
    Surface(
        color = scheme.surface.copy(alpha = .96f),
        contentColor = scheme.onSurface,
        shape = com.lo.imagine.ui.theme.themedShape(PopRadius.card),
        border = BorderStroke(1.dp, scheme.primary.copy(alpha = .24f)),
        modifier = modifier.fillMaxWidth()
    ) {
        Column(
            Modifier
                .drawBehind {
                    drawCircle(
                        color = scheme.tertiary.copy(alpha = .06f * pulse),
                        radius = 30.dp.toPx() + 8.dp.toPx() * pulse,
                        center = Offset(size.width - 20.dp.toPx(), 18.dp.toPx())
                    )
                }
                .padding(16.dp)
        ) {
            Row(verticalAlignment = Alignment.CenterVertically) {
                Box(
                    Modifier
                        .size(7.dp)
                        .background(scheme.primary.copy(alpha = .65f + .35f * pulse), CircleShape)
                )
                Spacer(Modifier.width(7.dp))
                Text(title, style = MaterialTheme.typography.titleSmall, color = scheme.onSurface, fontWeight = FontWeight.Black)
                Spacer(Modifier.weight(1f))
                Text("T+${elapsedSeconds}s", style = MaterialTheme.typography.labelSmall, color = scheme.primary, fontWeight = FontWeight.Bold)
            }
            Spacer(Modifier.height(8.dp))
            Row(verticalAlignment = Alignment.CenterVertically) {
                Text(
                    if (total > 1) "SPARKS  ${completed}/${total}" else "WAITING FOR MODEL",
                    style = MaterialTheme.typography.labelSmall,
                    color = scheme.onSurfaceVariant,
                    fontWeight = FontWeight.Bold
                )
                Spacer(Modifier.weight(1f))
                Text(
                    if (progress >= 1f) "READY" else "SPARKS ONLINE",
                    style = MaterialTheme.typography.labelSmall,
                    color = if (progress >= 1f) scheme.tertiary else scheme.secondary,
                    fontWeight = FontWeight.Black
                )
            }
            Spacer(Modifier.height(8.dp))
            SkyRenderLoader(trackHeight = 38.dp)
            Spacer(Modifier.height(8.dp))
            Box(
                Modifier
                    .fillMaxWidth()
                    .height(6.dp)
                    .clip(CircleShape)
                    .background(scheme.primary.copy(alpha = .12f))
            ) {
                Box(
                    Modifier
                        .fillMaxHeight()
                        .fillMaxWidth(progress)
                        .background(
                            androidx.compose.ui.graphics.Brush.horizontalGradient(
                                listOf(scheme.primary, scheme.secondary, scheme.tertiary)
                            )
                        )
                )
            }
            if (total > 1) {
                Spacer(Modifier.height(10.dp))
                Text(
                    if (completed == 0) "正在并行生成 $total 张" else "已完成 $completed / $total 张",
                    style = MaterialTheme.typography.bodySmall,
                    color = scheme.onSurfaceVariant
                )
            }
        }
    }
}

@Composable
private fun ArkGenerationStatus(
    elapsedSeconds: Int,
    mode: String,
    completed: Int,
    total: Int,
    modifier: Modifier = Modifier
) {
    val scheme = MaterialTheme.colorScheme
    val progress = if (total <= 0) 0f else (completed.toFloat() / total).coerceIn(0f, 1f)
    val title = when (mode.lowercase()) {
        "edit", "retouch" -> "RETOUCH // PROCESSING"
        else -> "CREATION // PROCESSING"
    }
    Surface(
        color = scheme.surface,
        contentColor = scheme.onSurface,
        shape = com.lo.imagine.ui.theme.themedShape(PopRadius.chip),
        border = BorderStroke(1.5.dp, scheme.outline),
        modifier = modifier.fillMaxWidth()
    ) {
        Column(
            Modifier
                .drawBehind {
                    val marker = 26.dp.toPx()
                    drawLine(scheme.primary, Offset(0f, 0f), Offset(marker, 0f), 2.dp.toPx())
                    drawLine(scheme.secondary, Offset(size.width - marker, size.height), Offset(size.width, size.height), 2.dp.toPx())
                }
                .padding(14.dp)
        ) {
            Row(verticalAlignment = Alignment.CenterVertically) {
                Text(
                    title,
                    style = MaterialTheme.typography.titleSmall,
                    color = scheme.onSurface,
                    fontWeight = FontWeight.Black
                )
                Spacer(Modifier.weight(1f))
                Text(
                    "T+${elapsedSeconds}s",
                    style = MaterialTheme.typography.labelSmall,
                    color = scheme.primary,
                    fontWeight = FontWeight.Bold
                )
            }
            Spacer(Modifier.height(8.dp))
            Row(verticalAlignment = Alignment.CenterVertically) {
                Text(
                    if (total > 1) "OUTPUT  ${completed}/${total}" else "AWAITING MODEL RESPONSE",
                    style = MaterialTheme.typography.labelSmall,
                    color = scheme.onSurfaceVariant,
                    fontWeight = FontWeight.Bold
                )
                Spacer(Modifier.weight(1f))
                Text(
                    if (progress >= 1f) "COMPLETE" else "LINK // STABLE",
                    style = MaterialTheme.typography.labelSmall,
                    color = if (progress >= 1f) scheme.secondary else scheme.tertiary,
                    fontWeight = FontWeight.Black
                )
            }
            Spacer(Modifier.height(10.dp))
            ArkRenderLoader(trackHeight = 42.dp)
            Spacer(Modifier.height(8.dp))
            Box(
                Modifier
                    .fillMaxWidth()
                    .height(5.dp)
                    .clip(com.lo.imagine.ui.theme.themedShape(PopRadius.chip))
                    .background(scheme.outline.copy(alpha = .22f))
            ) {
                Box(
                    Modifier
                        .fillMaxHeight()
                        .fillMaxWidth(progress)
                        .background(scheme.primary)
                )
            }
        }
    }
}

/** 罗德岛渲染轨：单色线框、节点刻度和扫描光标，避免波普马赛克色块。 */
@Composable
private fun ArkRenderLoader(
    modifier: Modifier = Modifier,
    trackHeight: Dp = 56.dp
) {
    val scheme = MaterialTheme.colorScheme
    val transition = rememberInfiniteTransition(label = "arkRenderTrack")
    val progress by transition.animateFloat(
        initialValue = -.12f,
        targetValue = 1.12f,
        animationSpec = infiniteRepeatable(tween(1900, easing = LinearEasing), RepeatMode.Restart),
        label = "arkRenderProgress"
    )
    val pulse by transition.animateFloat(
        initialValue = .42f,
        targetValue = 1f,
        animationSpec = infiniteRepeatable(tween(620, easing = FastOutSlowInEasing), RepeatMode.Reverse),
        label = "arkRenderPulse"
    )
    Canvas(
        modifier = modifier
            .fillMaxWidth()
            .height(trackHeight)
    ) {
        val mid = size.height / 2f
        val left = 8.dp.toPx()
        val right = size.width - left
        val line = 1.dp.toPx()
        val active = (left + (right - left) * progress).coerceIn(left, right)
        drawLine(scheme.outline.copy(alpha = .55f), Offset(left, mid), Offset(right, mid), line)
        val tickCount = 12
        for (i in 0..tickCount) {
            val x = left + (right - left) * i / tickCount
            val tick = if (i % 3 == 0) 10.dp.toPx() else 5.dp.toPx()
            drawLine(scheme.outline.copy(alpha = .62f), Offset(x, mid - tick), Offset(x, mid + tick), line)
        }
        if (progress >= 0f) {
            drawLine(scheme.primary.copy(alpha = .34f), Offset(left, mid), Offset(active, mid), 3.dp.toPx())
            drawLine(scheme.primary, Offset(active, mid - 16.dp.toPx()), Offset(active, mid + 16.dp.toPx()), 1.5.dp.toPx())
            drawCircle(scheme.primary.copy(alpha = .12f * pulse), 12.dp.toPx(), Offset(active, mid))
            val diamond = androidx.compose.ui.graphics.Path().apply {
                moveTo(active, mid - 5.dp.toPx())
                lineTo(active + 5.dp.toPx(), mid)
                lineTo(active, mid + 5.dp.toPx())
                lineTo(active - 5.dp.toPx(), mid)
                close()
            }
            drawPath(diamond, scheme.primary)
        }
        drawLine(scheme.secondary, Offset(right - 22.dp.toPx(), 0f), Offset(right, 0f), 2.dp.toPx())
        drawLine(scheme.tertiary, Offset(left, size.height), Offset(left + 22.dp.toPx(), size.height), 2.dp.toPx())
    }
}

@Composable
fun ImageResultCard(
    data: ImageData,
    modifier: Modifier = Modifier,
    onClick: () -> Unit
) {
    val cardShape = com.lo.imagine.ui.theme.themedShape(PopRadius.card)
    Surface(
        onClick = onClick,
        shape = cardShape,
        color = MaterialTheme.colorScheme.surface,
        tonalElevation = 0.dp,
        shadowElevation = 0.dp,
        border = androidx.compose.foundation.BorderStroke(1.5.dp, celInk()),
        modifier = modifier.celShadow(cardShape, dx = 2.dp, dy = 2.dp)
    ) {
        Box(modifier = Modifier.fillMaxSize().clip(cardShape)) {
            if (!data.url.isNullOrBlank()) {
                AsyncImage(
                    model = data.url,
                    contentDescription = "生成结果",
                    contentScale = ContentScale.Crop,
                    modifier = Modifier.fillMaxSize()
                )
            } else {
                val bitmap = remember(data.b64Json) { data.b64Json?.let { ImageUtils.decodeBase64(it) } }
                if (bitmap != null) {
                    Image(
                        bitmap = bitmap.asImageBitmap(),
                        contentDescription = "生成结果",
                        contentScale = ContentScale.Crop,
                        modifier = Modifier.fillMaxSize()
                    )
                } else {
                    Box(contentAlignment = Alignment.Center, modifier = Modifier.fillMaxSize()) {
                        PIcon(PopAlert, contentDescription = null, tint = MaterialTheme.colorScheme.onSurfaceVariant)
                    }
                }
            }
            Surface(
                shape = RoundedCornerShape(50),
                color = MaterialTheme.colorScheme.inverseSurface.copy(alpha = .78f),
                modifier = Modifier.align(Alignment.BottomEnd).padding(9.dp)
            ) {
                PIcon(
                    PopSpark,
                    contentDescription = null,
                    modifier = Modifier.padding(7.dp).size(14.dp),
                    tint = MaterialTheme.colorScheme.inversePrimary
                )
            }
        }
    }
}

