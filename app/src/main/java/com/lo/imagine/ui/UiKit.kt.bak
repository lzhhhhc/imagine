/** 罗德岛任务节点：方形终端框、状态脉冲与垂直扫描，不复用波普呼吸圆。 */
/** SKY 任务节点：糖果色圆徽章、星芒呼吸和斜向闪光，保持轻快但不喧宾夺主。 */
@Composable
private fun SkyBusyIcon(modifier: Modifier = Modifier) {
    val scheme = MaterialTheme.colorScheme
    val transition = rememberInfiniteTransition(label = "skyBusyNode")
    val pulse by transition.animateFloat(
        initialValue = .82f,
        targetValue = 1.08f,
        animationSpec = infiniteRepeatable(tween(820, easing = FastOutSlowInEasing), RepeatMode.Reverse),
        label = "skyBusyPulse"
    )
    val shimmer by transition.animateFloat(
        initialValue = -.35f,
        targetValue = 1.35f,
        animationSpec = infiniteRepeatable(tween(1500, easing = LinearEasing), RepeatMode.Restart),
        label = "skyBusyShimmer"
    )
    Box(contentAlignment = Alignment.Center, modifier = modifier) {
        Surface(
            shape = CircleShape,
            color = scheme.secondary.copy(alpha = .12f),
            modifier = Modifier
                .fillMaxSize()
                .graphicsLayer {
                    scaleX = pulse
                    scaleY = pulse
                    alpha = (1.48f - pulse).coerceIn(.30f, .66f)
                }
        ) {}
        Surface(
            shape = CircleShape,
            color = scheme.primaryContainer,
            border = BorderStroke(1.5.dp, scheme.primary.copy(alpha = .72f)),
            modifier = Modifier.fillMaxSize(.76f).drawBehind {
                val x = size.width * shimmer
                drawLine(
                    Color.White.copy(alpha = .48f),
                    Offset(x - size.height, size.height),
                    Offset(x, 0f),
                    strokeWidth = size.height * .25f
                )
            }
        ) {
            Box(contentAlignment = Alignment.Center) {
                PIcon(PopSpark, contentDescription = "处理中", tint = scheme.primary, modifier = Modifier.fillMaxSize(.48f))
            }
        }
    }
}

/** 罗德岛任务节点：方形终端框、状态脉冲与垂直扫描，不复用波普呼吸圆。 */
@Composable
private fun ArkBusyIcon(modifier: Modifier = Modifier) {
    val scheme = MaterialTheme.colorScheme
    val transition = rememberInfiniteTransition(label = "arkBusyNode")
    val scan by transition.animateFloat(
        initialValue = 0f,
        targetValue = 1f,
        animationSpec = infiniteRepeatable(
            tween(1180, easing = LinearEasing),
            RepeatMode.Restart
        ),
        label = "arkBusyScan"
    )
    val signal by transition.animateFloat(
        initialValue = .32f,
        targetValue = 1f,
        animationSpec = infiniteRepeatable(
            tween(540, easing = FastOutSlowInEasing),
            RepeatMode.Reverse
        ),
        label = "arkBusySignal"
    )

    Box(
        contentAlignment = Alignment.Center,
        modifier = modifier
            .clip(com.lo.imagine.ui.theme.themedShape(PopRadius.chip))
            .background(scheme.surfaceVariant.copy(alpha = .72f))
            .drawBehind {
                val stroke = 1.5.dp.toPx()
                val bracket = size.minDimension * .28f
                drawLine(scheme.primary, Offset.Zero, Offset(bracket, 0f), stroke)
                drawLine(scheme.primary, Offset.Zero, Offset(0f, bracket), stroke)
                drawLine(
                    scheme.primary,
                    Offset(size.width - bracket, size.height),
                    Offset(size.width, size.height),
                    stroke
                )
                drawLine(
                    scheme.primary,
                    Offset(size.width, size.height - bracket),
                    Offset(size.width, size.height),
                    stroke
                )
                val y = scan * size.height
                drawRect(
                    color = scheme.primary.copy(alpha = .12f),
                    topLeft = Offset(0f, (y - 4.dp.toPx()).coerceAtLeast(0f)),
                    size = Size(size.width, 8.dp.toPx().coerceAtMost(size.height))
                )
                drawLine(
                    color = scheme.primary.copy(alpha = .9f),
                    start = Offset(0f, y),
                    end = Offset(size.width, y),
                    strokeWidth = 1.dp.toPx()
                )
            }
    ) {
        PIcon(
            PopSpark,
            contentDescription = "处理中",
            tint = scheme.onSurface,
            modifier = Modifier.fillMaxSize(.48f)
        )
        Box(
            Modifier
                .align(Alignment.TopEnd)
                .padding(3.dp)
                .size(4.dp)
                .background(scheme.secondary.copy(alpha = signal))
        )
    }
}

/**
 * 加载循环动画：AI 渲染马赛克。
 * 一条高亮扫描线自左向右扫过，主题色马赛克块逐格「点亮」——隐喻 AI 正在逐块生成画面；
 * 扫完后整体渐隐，重新开始下一轮。优雅、安静、贴合绘画产品。
 */
@Composable
fun RunnerDinoLoader(
    modifier: Modifier = Modifier,
    trackHeight: Dp = 72.dp
) {
    val backdrop = com.lo.imagine.ui.theme.LocalFlavor.current.backdrop
    if (backdrop == com.lo.imagine.ui.theme.BackdropKind.ARK_TERMINAL) {
        ArkRenderLoader(modifier = modifier, trackHeight = trackHeight)
        return
    }
    if (backdrop == com.lo.imagine.ui.theme.BackdropKind.SKY) {
        SkyRenderLoader(modifier = modifier, trackHeight = trackHeight)
        return
    }

    val transition = rememberInfiniteTransition(label = "render")
    val cycle = 2600
    val progress by transition.animateFloat(
        initialValue = 0f,
        targetValue = 1f,
        animationSpec = infiniteRepeatable(
            animation = tween(cycle, easing = LinearEasing),
            repeatMode = RepeatMode.Restart
        ),
        label = "renderProgress"
    )
    val accents = LocalPopAccents.current
    val tileColors = listOf(accents.a, accents.b, accents.c, accents.d, accents.e)
    val scanColor = MaterialTheme.colorScheme.onSurface
    Canvas(
        modifier = modifier
            .fillMaxWidth()
            .height(trackHeight)
    ) {
        val w = size.width
        val h = size.height
        val cols = 7
        val rows = 3
        val gap = 3f
        val cw = (w - gap * (cols + 1)) / cols
        val ch = (h - gap * (rows + 1)) / rows
        val scanX = progress * (w + cw * 2f) - cw

        // 周期末整体渐隐（扫完 → 熄灭 → 重来）
        val fadeOut = if (progress > .90f) (1f - (progress - .90f) / .10f).coerceIn(0f, 1f) else 1f

        // 马赛克块：扫描线扫过即点亮；刚点亮的块更亮（正在渲染），已扫过的稳定半透明
        for (r in 0 until rows) {
            for (c in 0 until cols) {
                val x = gap + c * (cw + gap)
                val y = gap + r * (ch + gap)
                val centerX = x + cw / 2f
                val reveal = ((scanX - centerX) / cw * 1.15f + .08f).coerceIn(0f, 1f)
                if (reveal > 0f && fadeOut > 0f) {
                    val color = tileColors[(r * 3 + c * 5) % tileColors.size]
                    val alpha = (.20f + .5f * reveal) * fadeOut
                    drawRoundRect(
                        color = color.copy(alpha = alpha),
                        topLeft = Offset(x, y),
                        size = Size(cw, ch),
                        cornerRadius = androidx.compose.ui.geometry.CornerRadius(5f, 5f)
                    )
                }
            }
        }

        // 扫描光晕（线右侧渐隐）
        if (scanX < w) {
            drawRect(
                brush = androidx.compose.ui.graphics.Brush.horizontalGradient(
                    colors = listOf(
                        scanColor.copy(alpha = .14f * fadeOut),
                        androidx.compose.ui.graphics.Color.Transparent
                    ),
                    startX = scanX,
                    endX = scanX + cw * 1.8f
                ),
                topLeft = Offset(scanX, 0f),
                size = Size(cw * 1.8f, h)
            )
            // 扫描线
            drawLine(
                color = scanColor.copy(alpha = .85f * fadeOut),
                start = Offset(scanX, 0f),
                end = Offset(scanX, h),
                strokeWidth = 2f
            )
            // 线端菱形光标
            val cy = h / 2f
            val cursor = androidx.compose.ui.graphics.Path().apply {
                moveTo(scanX, cy - 5f)
                lineTo(scanX + 5f, cy)
                lineTo(scanX, cy + 5f)
                lineTo(scanX - 5f, cy)
                close()
            }
            drawPath(cursor, scanColor.copy(alpha = fadeOut))
        }
    }
}

/**
 * SKY 渲染轨：一条柔光沿细轨缓缓往返（取代旧版九宫格糖果块——九种彩色方块并排，
 * 看起来像调色盘而不是加载动画）。轨道极细、光带两端渐隐、头部一枚微光点，
 * Reverse 往返意味着循环端点永远平滑、没有任何硬切。
 */
@Composable
private fun SkyRenderLoader(
    modifier: Modifier = Modifier,
    trackHeight: Dp = 56.dp
) {
    val scheme = MaterialTheme.colorScheme
    val transition = rememberInfiniteTransition(label = "skyRenderTrack")
    val sweep by transition.animateFloat(
        initialValue = 0f,
        targetValue = 1f,
        animationSpec = infiniteRepeatable(
            tween(2300, easing = FastOutSlowInEasing),
            RepeatMode.Reverse
        ),
        label = "skyRenderSweep"
    )
    val breathe by transition.animateFloat(
        initialValue = .72f,
        targetValue = 1f,
        animationSpec = infiniteRepeatable(tween(1200, easing = FastOutSlowInEasing), RepeatMode.Reverse),
        label = "skyRenderBreathe"
    )
    Canvas(
        modifier = modifier
            .fillMaxWidth()
            .height(trackHeight)
    ) {
        val w = size.width
        val h = size.height
        val cy = h / 2f
        val trackH = 3.dp.toPx()
        val radius = androidx.compose.ui.geometry.CornerRadius(trackH, trackH)
        // 底轨：一条极淡的细线
        drawRoundRect(
            color = scheme.primary.copy(alpha = .10f),
            topLeft = Offset(0f, cy - trackH / 2f),
            size = Size(w, trackH),
            cornerRadius = radius
        )
        // 流动光带：固定长度、两端渐隐（primary → secondary 渐变），沿轨缓缓往返
        val seg = w * .34f
        val endX = seg / 2f + (w - seg) * sweep
        val left = (endX - seg).coerceAtLeast(0f)
        val right = endX.coerceAtMost(w)
        if (right > left) {
            drawRoundRect(
                brush = androidx.compose.ui.graphics.Brush.horizontalGradient(
                    colors = listOf(
                        scheme.primary.copy(alpha = 0f),
                        scheme.primary.copy(alpha = .68f),
                        scheme.secondary.copy(alpha = .62f),
                        scheme.primary.copy(alpha = 0f)
                    ),
                    startX = endX - seg,
                    endX = endX
                ),
                topLeft = Offset(left, cy - trackH / 2f),
                size = Size(right - left, trackH),
                cornerRadius = radius
            )
            // 头部微光：柔和光晕 + 白芯，随呼吸缩放
            drawCircle(
                color = scheme.primary.copy(alpha = .22f * breathe),
                radius = trackH * 2.6f * breathe,
                center = Offset(right, cy)
            )
            drawCircle(
                color = Color.White.copy(alpha = .72f),
                radius = trackH * .85f,
                center = Offset(right, cy)
            )
        }
    }
}

@Composable
fun LoadingLabel(text: String) {
    val backdrop = com.lo.imagine.ui.theme.LocalFlavor.current.backdrop
    if (backdrop == com.lo.imagine.ui.theme.BackdropKind.ARK_TERMINAL) {
        ArkLoadingLabel(text)
        return
    }
    if (backdrop == com.lo.imagine.ui.theme.BackdropKind.SKY) {
        SkyLoadingLabel(text)
        return
    }
    Row(verticalAlignment = Alignment.CenterVertically) {
        CreativeBusyIcon(Modifier.size(38.dp))
        Spacer(Modifier.width(12.dp))
        AnimatedContent(
            targetState = text,
            transitionSpec = { fadeIn(tween(180)) togetherWith fadeOut(tween(110)) },
            label = "loadingText"
        ) { value ->
            Text(value, style = MaterialTheme.typography.titleSmall)
        }
    }
}

/** SKY 加载标签：状态徽章与文字切换保持轻盈，并用细扫线连接到当前任务。 */
@Composable
private fun SkyLoadingLabel(text: String) {
    val scheme = MaterialTheme.colorScheme
    val transition = rememberInfiniteTransition(label = "skyLoadingLabel")
    val sweep by transition.animateFloat(
        initialValue = -.25f,
        targetValue = 1.25f,
        animationSpec = infiniteRepeatable(tween(1700, easing = LinearEasing), RepeatMode.Restart),
        label = "skyLoadingSweep"
    )
    Row(
        verticalAlignment = Alignment.CenterVertically,
        modifier = Modifier
            .fillMaxWidth()
            .clip(com.lo.imagine.ui.theme.themedShape(PopRadius.card))
            .background(scheme.surface.copy(alpha = .92f))
            .drawBehind {
                // 底线上的一段流光：固定长度、两端渐隐，替代斜跨整卡的斜线
                val seg = size.width * .22f
                val n = ((sweep + .25f) / 1.5f).coerceIn(0f, 1f)
                val endX = 12.dp.toPx() + n * (size.width - 24.dp.toPx() + seg) - seg
                val segStart = (endX - seg).coerceAtLeast(12.dp.toPx())
                val segWidth = seg.coerceAtMost(size.width - 12.dp.toPx() - segStart)
                if (segWidth > 0f) {
                    drawRect(
                        brush = androidx.compose.ui.graphics.Brush.horizontalGradient(
                            colors = listOf(
                                scheme.primary.copy(alpha = 0f),
                                scheme.primary.copy(alpha = .55f),
                                scheme.primary.copy(alpha = 0f)
                            ),
                            startX = endX - seg,
                            endX = endX
                        ),
                        topLeft = Offset(segStart, size.height - 1.5f),
                        size = Size(segWidth, 1.5f)
                    )
                }
            }
            .padding(horizontal = 12.dp, vertical = 8.dp)
    ) {
        SkyBusyIcon(Modifier.size(28.dp))
        Spacer(Modifier.width(10.dp))
        AnimatedContent(
            targetState = text,
            transitionSpec = { fadeIn(tween(160)) togetherWith fadeOut(tween(100)) },
            label = "skyLoadingText"
        ) { value ->
            Column {
                Text(
                    "SKY // CREATING",
                    style = MaterialTheme.typography.labelSmall,
                    color = scheme.primary,
                    fontWeight = FontWeight.Black
                )
                Text(
                    value,
                    style = MaterialTheme.typography.titleSmall,
                    color = scheme.onSurface,
                    fontWeight = FontWeight.Bold
                )
            }
        }
        Spacer(Modifier.weight(1f))
        Text("✦", color = scheme.secondary, style = MaterialTheme.typography.labelSmall, fontWeight = FontWeight.Black)
    }
}

