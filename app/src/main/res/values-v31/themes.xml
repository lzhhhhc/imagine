<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+：透明系统图标和背景，视频首帧接管；不重复展示头像。 -->
<resources>
    <style name="Theme.MyApplication" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">60</item>
        <item name="android:windowBackground">@drawable/launch_bg</item>
    </style>
</resources>
